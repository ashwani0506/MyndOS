# Copy to .env in this same folder (repo root) and fill in what you have.
# Every key is optional -- the router uses whatever is present and skips the rest.

# Free, 1000 req/day on gpt-oss-120b. console.groq.com  <- best free tier, start here
GROQ_API_KEY=

# Free tier, no credit card. aistudio.google.com/apikey
GEMINI_API_KEY=

# 50 free req/day (1000 after a one-time $10). openrouter.ai/keys
OPENROUTER_API_KEY=

# Third-party reseller key. Only serves a fixed window -- set `window=` on the
# claude provider in backend/brain.py to match, so it's skipped the rest of the
# day. Leave CLAUDE_BASE_URL unset for Anthropic direct.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=

# No key needed for Ollama -- just `ollama serve` and `ollama pull qwen3:4b`.
